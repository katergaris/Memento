<?xml version="1.0" encoding="utf-8"?>
<!-- Widget senza dati (niente contenuti dell'archivio cifrato sulla schermata
     Home): tre tasti che aprono l'app nel punto giusto. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="8dp" android:gravity="center"
    android:background="@drawable/memento_widget_bg">
    <TextView android:id="@+id/w_note" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="4dp" android:gravity="center"
        android:background="@drawable/memento_widget_main" android:text="@string/shortcut_note"
        android:textColor="#121318" android:textStyle="bold" android:textSize="13sp" />
    <TextView android:id="@+id/w_cards" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="4dp" android:gravity="center"
        android:background="@drawable/memento_widget_btn" android:text="@string/shortcut_cards"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp" />
    <TextView android:id="@+id/w_receive" android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_margin="4dp" android:gravity="center"
        android:background="@drawable/memento_widget_btn" android:text="@string/shortcut_receive"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp" />
</LinearLayout>
